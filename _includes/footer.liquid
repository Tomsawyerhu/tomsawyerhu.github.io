{% capture footer_contents %}
  <figure
    class="footer-quote"
    data-quotes-url="{{ '/assets/json/philosophical_quotes.json' | relative_url }}"
  >
    <blockquote class="footer-quote__text">
      “<span data-quote-text>The soul becomes dyed with the colour of its thoughts.</span>”
    </blockquote>
    <figcaption class="footer-quote__author" data-quote-author>— Marcus Aurelius</figcaption>
  </figure>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

<script defer src="{{ '/assets/js/footer-quote.js' | relative_url | bust_file_cache }}"></script>
